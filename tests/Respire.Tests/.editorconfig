# Only these audited probe fixtures opt out of production client-lifetime advice.
# Each scenario owns fake servers and clients with specific capacity, topology,
# retry, or telemetry settings. Sharing clients would leak state between scenarios;
# await using keeps each client alive for its whole scenario and then disposes it.
[{DispatchResponseObservationTests,StandaloneCircuitAllocationTests,StandaloneReplicaReadyTests,StandaloneBatchFlushTests,ReplicaRedirectTests,ReplicaRedirectTests.TrackedScripts,ReplicaRedirectCacheTests,ReplicaRedirectTargetRecoveryTests,ReplicaRedirectEvictionTests}.cs]
dotnet_diagnostic.RESP010.severity = none

# These wire fixtures own clients for fake-server cache/tracking/topology settings
# or credential identity, expiry, protocol, and renewal state. Reusing a client
# across scenarios would invalidate their isolation and connection-lifetime probes.
[Networking/{HashMultiReadCacheTests,CredentialProviderTests}.cs]
dotnet_diagnostic.RESP010.severity = none
