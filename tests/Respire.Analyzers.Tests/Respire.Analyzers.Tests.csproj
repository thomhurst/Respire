<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The analyzer harness only needs one host TFM; clear the repo-wide multi-targeting. -->
        <TargetFrameworks></TargetFrameworks>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Respire\Respire.csproj" />
        <ProjectReference Include="..\..\src\Respire.Json\Respire.Json.csproj" />
        <ProjectReference Include="..\..\src\Respire.Analyzers\Respire.Analyzers.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.CodeFix.Testing" />
        <!-- The testing packages float to Roslyn 1.0.1; pin the graph to the version the
             analyzer itself compiles against. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
        <!-- Execute CA2012 in contract tests without replacing the SDK's build analyzers. -->
        <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" GeneratePathProperty="true" IncludeAssets="none" PrivateAssets="all" />
        <Reference Include="Microsoft.CodeAnalysis.NetAnalyzers"
                   HintPath="$(PkgMicrosoft_CodeAnalysis_NetAnalyzers)/analyzers/dotnet/cs/Microsoft.CodeAnalysis.NetAnalyzers.dll" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="TestInspectionOwnerSurface.txt" LogicalName="TestInspectionOwnerSurface.txt" />
        <!-- Test the exact library source without depending on a checkout at test runtime. -->
        <EmbeddedResource Include="../../src/**/*.cs" Exclude="../../src/**/bin/**;../../src/**/obj/**"
                          LogicalName="LibrarySource/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="EmbedInspectionConfigurations" BeforeTargets="AssignTargetPaths">
        <PropertyGroup>
            <_InspectionImport>$(MSBuildThisFileDirectory)TestInspectionConfiguration.targets</_InspectionImport>
            <_InspectionResource>$(IntermediateOutputPath)TestInspectionConfigurations.txt</_InspectionResource>
        </PropertyGroup>
        <MSBuild Projects="../../src/Respire/Respire.csproj" Targets="GetInspectionFrameworks"
                 RemoveProperties="TargetFramework;TargetFrameworks"
                 Properties="CustomAfterMicrosoftCommonCrossTargetingTargets=$(_InspectionImport);CustomAfterMicrosoftCommonTargets=$(_InspectionImport)">
            <Output TaskParameter="TargetOutputs" ItemName="_InspectionFramework" />
        </MSBuild>
        <MSBuild Projects="../../src/Respire/Respire.csproj" Targets="GetInspectionConfiguration"
                 RemoveProperties="TargetFrameworks"
                 Properties="TargetFramework=%(_InspectionFramework.Identity);CustomAfterMicrosoftCommonTargets=$(_InspectionImport)">
            <Output TaskParameter="TargetOutputs" ItemName="_InspectionConfiguration" />
        </MSBuild>
        <WriteLinesToFile File="$(_InspectionResource)" Lines="@(_InspectionConfiguration)" Overwrite="true" WriteOnlyWhenDifferent="true" />
        <ItemGroup>
            <EmbeddedResource Include="$(_InspectionResource)" LogicalName="TestInspectionConfigurations.txt" />
            <FileWrites Include="$(_InspectionResource)" />
        </ItemGroup>
    </Target>

</Project>
