<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net11.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Respire.Pipeline\Respire.Pipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ModularPipelines 4 adds a global using whose NotInParallel attribute clashes with TUnit's. -->
    <Using Remove="ModularPipelines" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Moq" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>

</Project>
