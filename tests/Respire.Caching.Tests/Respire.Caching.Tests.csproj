<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- TUnit0023 false-positives: the flagged cache fields ARE disposed in [After(Test)]. -->
        <NoWarn>$(NoWarn);TUnit0023</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="Testcontainers.Redis" />
        <PackageReference Include="Microsoft.AspNetCore.OutputCaching.StackExchangeRedis" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <!-- The Microsoft implementation, used to prove the wire layouts are interchangeable. -->
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <!-- AddDistributedMemoryCache, for the registration-override test. -->
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\RedisTestContainer.cs" Link="RedisTestContainer.cs" />
        <Compile Include="..\Respire.IntegrationTests\RedisClusterTestContainer.cs" Link="RedisClusterTestContainer.cs" />
        <Compile Include="..\Respire.Tests\Networking\FakeRespServer.cs" Link="FakeRespServer.cs" />
        <Using Include="Respire.Testing" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Respire.Caching\Respire.Caching.csproj" />
        <ProjectReference Include="..\..\src\Respire.OutputCaching\Respire.OutputCaching.csproj" />
        <ProjectReference Include="..\..\src\Respire.DependencyInjection\Respire.DependencyInjection.csproj" />
    </ItemGroup>

</Project>
