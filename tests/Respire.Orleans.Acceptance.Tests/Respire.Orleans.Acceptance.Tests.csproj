<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The pinned providers expose their internals to this upstream test assembly. -->
    <AssemblyName>Orleans.Redis.Tests</AssemblyName>
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep the source inventory and recorded results on their assessed provider version. -->
    <PackageVersion Update="Microsoft.Orleans.Clustering.Redis" Version="10.2.2" />
    <PackageVersion Update="Microsoft.Orleans.Persistence.Redis" Version="10.2.2" />
    <PackageVersion Update="Microsoft.Orleans.Reminders.Redis" Version="10.2.2" />
    <PackageVersion Include="Microsoft.Orleans.Server" Version="10.2.2" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Testcontainers.Redis" />
    <PackageReference Include="xunit.assert" />
    <PackageReference Include="Microsoft.Orleans.Clustering.Redis" />
    <PackageReference Include="Microsoft.Orleans.Persistence.Redis" />
    <PackageReference Include="Microsoft.Orleans.Reminders.Redis" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <ProjectReference Include="../../src/Respire.StackExchangeCompat/Respire.StackExchangeCompat.csproj" />
    <ProjectReference Include="../../src/Respire.Testing.Containers/Respire.Testing.Containers.csproj" />
    <Compile Include="../RedisTestContainer.cs" Link="RedisTestContainer.cs" />
    <Compile Include="../ContainerStartRetry.cs" Link="ContainerStartRetry.cs" />
    <Using Include="Respire.Testing" />
  </ItemGroup>
</Project>
