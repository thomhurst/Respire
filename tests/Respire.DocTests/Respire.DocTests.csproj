<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Redis.StackExchange" Version="1.12.0" />
    <PackageReference Include="Aspire.Respire" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Aspire.Respire.DistributedCaching" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Aspire.Respire.HybridCaching" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Aspire.Respire.OutputCaching" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Compression.Lz4" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Compression.Zstd" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Testing" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Testing.Containers" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Caching" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Coordination" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Aws" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Caching.Hybrid" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.FusionCache" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.SignalR" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.StackExchangeCompat" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Streaming" Version="$(RespirePackageVersion)" />
    <PackageReference Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="2.9.0" />
    <PackageReference Include="Respire.DependencyInjection" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.DataProtection" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.HealthChecks" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Azure" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Respire.Json" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.OutputCaching" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Search" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.VectorData" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.TimeSeries" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Probabilistic" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="$(GeneratedSnippetsPath)" Link="GeneratedSnippets.g.cs" />
    <Compile Include="../../samples/Respire.Samples.VectorData/Movie.cs" Link="VectorDataMovie.cs" />
    <Compile Include="../../samples/Respire.Samples.VectorData/JsonMovie.cs" Link="VectorDataJsonMovie.cs" />
  </ItemGroup>

  <Target Name="RecordExpectedRuntimeAssemblies" BeforeTargets="GetAssemblyAttributes">
    <!-- Package and runtime assembly names intentionally match. Derive the expected
         set from references so adding a package cannot silently omit its audit. -->
    <ItemGroup>
      <AssemblyMetadata Include="ExpectedRuntimeAssembly" Value="%(PackageReference.Identity)"
                        Condition="'%(PackageReference.Identity)' == 'Respire' Or $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Respire.')) Or '%(PackageReference.Identity)' == 'Aspire.Respire' Or $([System.String]::Copy('%(PackageReference.Identity)').StartsWith('Aspire.Respire.'))" />
    </ItemGroup>
  </Target>

</Project>
