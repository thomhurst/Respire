    <PackageReference Include="Respire.Extensions.Caching.Hybrid" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Extensions.DependencyInjection" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Extensions.Azure" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Respire.Json" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Respire.Probabilistic" Version="$(RespirePackageVersion)" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.19.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(GeneratedSnippetsPath)" Link="GeneratedSnippets.g.cs" />
  </ItemGroup>

</Project>
