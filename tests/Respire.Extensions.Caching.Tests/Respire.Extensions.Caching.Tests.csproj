<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <LangVersion>13</LangVersion>
        <!-- Bridge Microsoft.Testing.Platform (TUnit) into `dotnet test` for the pipeline. -->
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <!-- TUnit0023 false-positives: the flagged cache fields ARE disposed in [After(Test)]. -->
        <NoWarn>$(NoWarn);TUnit0023</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="0.57.1" />
        <PackageReference Include="Testcontainers.Redis" Version="4.7.0" />
        <!-- The Microsoft implementation, used to prove the wire layouts are interchangeable. -->
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="9.0.8" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.8" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Respire.Extensions.Caching\Respire.Extensions.Caching.csproj" />
    </ItemGroup>

</Project>
