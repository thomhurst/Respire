<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <LangVersion>13</LangVersion>
        <!-- Bridge Microsoft.Testing.Platform (TUnit) into `dotnet test` for the pipeline. -->
        <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
        <!-- TUnit0023 false-positives: the flagged cache fields ARE disposed in [After(Test)]. -->
        <NoWarn>$(NoWarn);TUnit0023</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" Version="1.64.0" />
        <PackageReference Include="Testcontainers.Redis" Version="4.13.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
        <!-- The Microsoft implementation, used to prove the wire layouts are interchangeable. -->
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <!-- AddDistributedMemoryCache, for the registration-override test. -->
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\RedisTestContainer.cs" Link="RedisTestContainer.cs" />
        <Using Include="Respire.Testing" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Respire.Extensions.Caching\Respire.Extensions.Caching.csproj" />
    </ItemGroup>

</Project>
