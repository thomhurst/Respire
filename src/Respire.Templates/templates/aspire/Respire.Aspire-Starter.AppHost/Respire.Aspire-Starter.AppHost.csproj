<Project Sdk="Microsoft.NET.Sdk">
  <!-- Maintainers: keep hosting packages aligned with Directory.Packages.props. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="17.0.0" />
    <!-- Override Aspire.Hosting's transitive 2.5.302 with the patched version used by this repository.
         Verify-Templates.ps1 builds and runs the generated AppHost to check compatibility. -->
    <PackageReference Include="MessagePack" Version="3.1.12" />
  </ItemGroup>
</Project>
