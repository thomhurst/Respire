<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Respire.Extensions.Caching</PackageId>
    <Title>Respire.Extensions.Caching</Title>
    <Description>IDistributedCache and IBufferDistributedCache implementations backed by Respire.</Description>
    <PackageTags>$(PackageTags);distributed-cache;ibufferdistributedcache;extensions-caching</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respire\Respire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests execute the production Lua scripts with adversarial timings (a delayed
         send cannot be reproduced through the public API). -->
    <InternalsVisibleTo Include="Respire.Extensions.Caching.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- IBufferDistributedCache first shipped in 9.x with net8.0 assets. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
