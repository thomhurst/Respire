<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Respire.Caching.Hybrid</PackageId>
    <Title>Respire.Caching.Hybrid</Title>
    <Description>HybridCache Redis backend and opt-in server-assisted L1 coherence backed by Respire.</Description>
    <PackageTags>$(PackageTags);hybridcache;distributed-cache;client-side-cache;extensions-caching</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respire.Caching\Respire.Caching.csproj" />
    <InternalsVisibleTo Include="Respire.Caching.Hybrid.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- HybridCache has no 8.x package; 9.x is the oldest stable line with net8.0 assets. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
  </ItemGroup>

</Project>
