<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Respire.Probabilistic</PackageId>
    <Title>Respire.Probabilistic</Title>
    <Description>Typed Redis probabilistic data structure commands for Respire.</Description>
    <PackageTags>$(PackageTags);redis;probabilistic;Bloom;Cuckoo;Count-Min;Top-K;t-digest</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Respire\Respire.csproj" />
    <!-- Runs the command generator for this project only. Consumers get the generator from the Respire
         package; shipping it here as well would run it twice and duplicate every generated type. -->
    <ProjectReference Include="..\Respire.Analyzers\Respire.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>
</Project>
