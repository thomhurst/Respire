<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Respire.Json</PackageId>
    <Title>Respire.Json</Title>
    <Description>Typed RedisJSON commands and source-generated serialization for Respire.</Description>
    <PackageTags>$(PackageTags);redisjson;json;redis-stack;valkey</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respire\Respire.csproj" />
    <ProjectReference Include="..\Respire.Analyzers\Respire.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>
</Project>
