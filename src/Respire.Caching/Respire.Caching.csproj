<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Respire.Caching</PackageId>
    <Title>Respire.Caching</Title>
    <Description>IDistributedCache and IBufferDistributedCache implementations backed by Respire.</Description>
    <PackageTags>$(PackageTags);distributed-cache;ibufferdistributedcache;extensions-caching</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respire\Respire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the tests execute the production Lua scripts with adversarial timings (a delayed
         send cannot be reproduced through the public API). -->
    <InternalsVisibleTo Include="Respire.Caching.Tests" />
    <InternalsVisibleTo Include="Respire.Caching.Hybrid" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
  </ItemGroup>

</Project>
