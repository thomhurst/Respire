<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Respire.DependencyInjection</PackageId>
    <Title>Respire.DependencyInjection</Title>
    <Description>Dependency injection integration for Respire clients in Microsoft.Extensions.DependencyInjection applications.</Description>
    <PackageTags>$(PackageTags);dependency-injection;extensions</PackageTags>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respire\Respire.csproj" />
    <ProjectReference Include="..\Respire.Analyzers\Respire.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <InternalsVisibleTo Include="Respire.Aspire" />
    <InternalsVisibleTo Include="Respire.Caching.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

</Project>
