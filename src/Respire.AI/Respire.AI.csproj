<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>Respire.AI</PackageId>
    <Title>Respire.AI</Title>
    <Description>Redis chat history, agent memory, semantic response caching, and exact-text embedding caching for Microsoft.Extensions.AI.</Description>
    <PackageTags>$(PackageTags);ai;semantic-cache;chat-history;agent-memory;embeddings</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Respire.Search/Respire.Search.csproj" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Agents.AI.Abstractions" />
  </ItemGroup>
</Project>
