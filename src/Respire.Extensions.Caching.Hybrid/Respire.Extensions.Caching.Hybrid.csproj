<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Respire.Extensions.Caching.Hybrid</PackageId>
    <Title>Respire.Extensions.Caching.Hybrid</Title>
    <Description>HybridCache L2 backend integration backed by Respire.</Description>
    <PackageTags>$(PackageTags);hybridcache;distributed-cache;extensions-caching</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Respire.Extensions.Caching\Respire.Extensions.Caching.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <!-- HybridCache has no 8.x package; 9.x is the oldest stable line with net8.0 assets. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
  </ItemGroup>

</Project>
