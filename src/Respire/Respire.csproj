<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <AssemblyName>Respire</AssemblyName>
    <RootNamespace>Respire</RootNamespace>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The caching package needs wire-level primitives no public API should promise: a reply
         wait immune to CommandTimeout, Redis connection identities, and all-connection sends
         for FIFO-ordered TTL corrections. -->
    <InternalsVisibleTo Include="Respire.Extensions.Caching" />
    <InternalsVisibleTo Include="Respire.Extensions.Caching.Tests" />
    <InternalsVisibleTo Include="Respire.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Pipelines" Version="9.0.8" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="9.0.8" />
    <PackageReference Include="System.Threading.Channels" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="9.0.8" />
  </ItemGroup>

</Project>
