<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Respire</AssemblyName>
    <RootNamespace>Respire</RootNamespace>
    <PackageId>Respire</PackageId>
    <Title>Respire</Title>
    <Description>Fast, modern RESP client for Redis, Valkey, KeyDB, and other RESP-compatible servers.</Description>
    <PackageTags>$(PackageTags);redis-client;valkey-client;keydb-client</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <!-- The caching package needs wire-level primitives no public API should promise: a reply
         wait immune to CommandTimeout, Redis connection identities, and all-connection sends
         for FIFO-ordered TTL corrections. -->
    <InternalsVisibleTo Include="Respire.Extensions.Caching" />
    <InternalsVisibleTo Include="Respire.Extensions.Caching.Tests" />
    <!-- Reuse owned binary keys and the managed lock's cancellation-safe renewal lifecycle. -->
    <InternalsVisibleTo Include="Respire.Extensions.Coordination" />
    <InternalsVisibleTo Include="Respire.Extensions.Coordination.Tests" />
    <InternalsVisibleTo Include="Respire.Tests" />
    <InternalsVisibleTo Include="Respire.IntegrationTests" />
    <InternalsVisibleTo Include="Respire.Benchmarks" />
    <!-- The optional package implements reserved value-codec algorithm ID 3. -->
    <InternalsVisibleTo Include="Respire.Compression.Lz4" />
    <!-- The optional package implements reserved value-codec algorithm ID 4. -->
    <InternalsVisibleTo Include="Respire.Compression.Zstd" />
    <InternalsVisibleTo Include="Respire.Testing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Source-only: supplies System.Threading.Lock (with lock-statement support) on net8. -->
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="Reservoir" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build-order only: the analyzers ride along in this package (see _PackRespireAnalyzers),
         they are neither a dependency nor a compile reference of the library. -->
    <ProjectReference Include="..\Respire.Analyzers\Respire.Analyzers.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Ship the command generator and diagnostics inside the Respire package automatically.
       The path is TFM-independent, so this runs once on the outer (cross-targeting) build. -->
  <Target Name="_PackRespireAnalyzers" BeforeTargets="_GetPackageFiles">
    <MSBuild Projects="..\Respire.Analyzers\Respire.Analyzers.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="_RespireAnalyzerAssembly" />
    </MSBuild>
    <Error Condition="'@(_RespireAnalyzerAssembly)' == ''"
           Text="Respire.Analyzers.dll was not produced for packaging." />
    <PropertyGroup>
      <_RespireAnalyzerOutputDir>%(_RespireAnalyzerAssembly.RootDir)%(_RespireAnalyzerAssembly.Directory)</_RespireAnalyzerOutputDir>
    </PropertyGroup>
    <ItemGroup>
      <None Include="@(_RespireAnalyzerAssembly)" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
      <_RespireAnalyzerDependency
          Include="$(_RespireAnalyzerOutputDir)*.dll"
          Exclude="@(_RespireAnalyzerAssembly);
                   $(_RespireAnalyzerOutputDir)Respire.Analyzers.dll;
                   $(_RespireAnalyzerOutputDir)Microsoft.CodeAnalysis.dll;
                   $(_RespireAnalyzerOutputDir)Microsoft.CodeAnalysis.CSharp.dll" />
      <None Include="@(_RespireAnalyzerDependency)"
            Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    </ItemGroup>
  </Target>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.IO.Pipelines" />
    <!-- InstrumentAdvice<T> first shipped in 9.x with net8.0 assets. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.IO.Pipelines" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

</Project>
