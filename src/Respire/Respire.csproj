<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>preview</LangVersion>
    <AssemblyName>Respire</AssemblyName>
    <RootNamespace>Respire</RootNamespace>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The caching package needs wire-level primitives no public API should promise: a reply
         wait immune to CommandTimeout, Redis connection identities, and all-connection sends
         for FIFO-ordered TTL corrections. -->
    <InternalsVisibleTo Include="Respire.Extensions.Caching" />
    <InternalsVisibleTo Include="Respire.Extensions.Caching.Tests" />
    <InternalsVisibleTo Include="Respire.Tests" />
    <InternalsVisibleTo Include="Respire.Benchmarks" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.IO.Pipelines" />
    <!-- InstrumentAdvice<T> first shipped in 9.x with net8.0 assets. -->
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.IO.Pipelines" />
    <PackageReference Include="System.Diagnostics.DiagnosticSource" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>

</Project>
