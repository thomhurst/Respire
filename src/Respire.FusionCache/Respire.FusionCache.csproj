<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Title>Respire.FusionCache</Title>
    <Description>FusionCache backplane and distributed locker using a shared Respire client.</Description>
    <PackageTags>$(PackageTags);fusioncache;backplane;locking</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <!-- Deterministic bounds for the internal polling policy; no public test hooks. -->
    <InternalsVisibleTo Include="Respire.FusionCache.Tests" />
    <ProjectReference Include="../Respire/Respire.csproj" />
    <ProjectReference Include="../Respire.Coordination/Respire.Coordination.csproj" />
    <PackageReference Include="ZiggyCreatures.FusionCache" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
