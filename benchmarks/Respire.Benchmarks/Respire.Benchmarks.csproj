<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Copied fixtures still compile against baselines with the immediate writer contract. -->
    <DefineConstants>$(DefineConstants);FENCED_LOCKS;RESERVED_RESP_WRITER</DefineConstants>
    <DefineConstants Condition="'$(RateLimiterApiBenchmark)' == 'true'">$(DefineConstants);RATE_LIMITER_API</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Respire\Respire.csproj" />
    <ProjectReference Include="..\..\src\Respire.Json\Respire.Json.csproj" />
    <ProjectReference Include="..\..\src\Respire.Search\Respire.Search.csproj" />
    <ProjectReference Include="..\..\src\Respire.Analyzers\Respire.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\Respire.Coordination\Respire.Coordination.csproj" />
    <ProjectReference Include="..\..\src\Respire.Compression.Lz4\Respire.Compression.Lz4.csproj" />
    <ProjectReference Include="..\..\src\Respire.Compression.Zstd\Respire.Compression.Zstd.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Testcontainers.Redis" />
  </ItemGroup>

</Project>
