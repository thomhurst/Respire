<Project>
    <PropertyGroup>
        <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- The public API uses C# 13 params collections (params ReadOnlySpan<T>). -->
        <LangVersion>13</LangVersion>
    </PropertyGroup>
</Project>
