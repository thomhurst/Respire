<Project>
  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The public API uses C# 13 params collections (params ReadOnlySpan<T>). -->
    <LangVersion>14</LangVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Projects that ship as NuGet packages, one per line. Add a new package project here.
      Whitespace is stripped and the list gets a leading ';', so membership is an exact ';Name;' match.
      _RespireValidatePackageProjectList (below) fails the build when a listed name has no project under
      src/, or when a src/ project is neither listed nor in RespireNonPackageProjects.
    -->
    <RespirePackageProjects>
      Respire;
      Respire.Compression.Lz4;
      Respire.Compression.Zstd;
      Respire.Aws;
      Respire.Azure;
      Respire.Caching;
      Respire.Caching.Hybrid;
      Respire.Coordination;
      Respire.DataProtection;
      Respire.DependencyInjection;
      Respire.HealthChecks;
      Respire.Json;
      Respire.OutputCaching;
      Respire.Probabilistic;
      Respire.Search;
      Respire.TimeSeries;
      Respire.Testing;
      Respire.Testing.Containers;
    </RespirePackageProjects>
    <_RespirePackageProjectList>;$([System.Text.RegularExpressions.Regex]::Replace('$(RespirePackageProjects)', '\s', ''))</_RespirePackageProjectList>
    <IsRespirePackageProject>false</IsRespirePackageProject>
    <IsRespirePackageProject Condition="$(_RespirePackageProjectList.Contains(';$(MSBuildProjectName);'))">true</IsRespirePackageProject>
    <IsPackable>$(IsRespirePackageProject)</IsPackable>
    <!-- src/ projects that deliberately do not ship as their own package. -->
    <RespireNonPackageProjects>;Respire.Analyzers;</RespireNonPackageProjects>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsRespirePackageProject)' == 'true' Or '$(MSBuildProjectName)' == 'Respire.Analyzers'">
    <!-- Includes the netstandard analyzer assembly, where SDK analyzers are not enabled by default. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
  </PropertyGroup>

  <!-- Runs once, in the core project, so a typo in the package list cannot silently make a project unpackable. -->
  <Target Name="_RespireValidatePackageProjectList" BeforeTargets="Build" Condition="'$(MSBuildProjectName)' == 'Respire'">
    <ItemGroup>
      <_RespireListedPackageProject Include="$([MSBuild]::Unescape($(_RespirePackageProjectList)))" />
      <_RespireSourceProject Include="$(MSBuildThisFileDirectory)src/*/*.csproj" />
    </ItemGroup>
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)src/%(_RespireListedPackageProject.Identity)/%(_RespireListedPackageProject.Identity).csproj')"
           Text="RespirePackageProjects lists '%(_RespireListedPackageProject.Identity)', but src/%(_RespireListedPackageProject.Identity)/%(_RespireListedPackageProject.Identity).csproj does not exist." />
    <Error Condition="!$(_RespirePackageProjectList.Contains(';%(_RespireSourceProject.Filename);')) And !$(RespireNonPackageProjects.Contains(';%(_RespireSourceProject.Filename);'))"
           Text="src project '%(_RespireSourceProject.Filename)' is not in RespirePackageProjects or RespireNonPackageProjects in Directory.Build.props." />
  </Target>

  <Target Name="_RespireValidateLibraryNaming" BeforeTargets="PrepareForBuild"
          Condition="'$(IsRespirePackageProject)' == 'true' Or '$(MSBuildProjectName)' == 'Respire.Analyzers'">
    <Error Condition="'$(AssemblyName)' != '$(MSBuildProjectName)' Or '$(RootNamespace)' != '$(MSBuildProjectName)'"
           Text="Library project $(MSBuildProjectName) must use its project name for AssemblyName and RootNamespace." />
    <Error Condition="'$(IsRespirePackageProject)' == 'true' And '$(PackageId)' != '$(MSBuildProjectName)'"
           Text="Library project $(MSBuildProjectName) must use its project name for PackageId." />
  </Target>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Respire.DataProtection.Tests' Or '$(MSBuildProjectName)' == 'Respire.Coordination.Tests' Or '$(MSBuildProjectName)' == 'Respire.Azure.Tests' Or '$(MSBuildProjectName)' == 'Respire.Tests' Or '$(MSBuildProjectName)' == 'Respire.IntegrationTests' Or '$(MSBuildProjectName)' == 'Respire.Caching.Tests' Or '$(MSBuildProjectName)' == 'Respire.Caching.Hybrid.Tests' Or '$(MSBuildProjectName)' == 'Respire.HealthChecks.Tests' Or '$(MSBuildProjectName)' == 'Respire.Pipeline.Tests'">
    <IsTestProject>true</IsTestProject>
    <!-- Bridge Microsoft.Testing.Platform (TUnit) into `dotnet test` for the pipeline. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsRespirePackageProject)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <Authors>Tom Hurst</Authors>
    <Company>Respire</Company>
    <Product>Respire</Product>
    <Copyright>Copyright (c) 2026 Tom Hurst</Copyright>
    <PackageProjectUrl>https://thomhurst.github.io/Respire/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thomhurst/Respire</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>redis;valkey;keydb;resp;cache;caching;client;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLanguage>en-US</PackageLanguage>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsRespirePackageProject)' == 'true'">
    <None Include="$(RepositoryRoot)README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
