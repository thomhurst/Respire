<Project>
  <!-- Keep source-filtered local test builds out of the full suite's assets and outputs.
       This must precede Microsoft.Common.props' intermediate-path defaults. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Respire.Tests' And '$(RespireTestFilter)' != ''">
    <BaseIntermediateOutputPath>obj/focused/</BaseIntermediateOutputPath>
    <BaseOutputPath>bin/focused/</BaseOutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)/obj/**;$(MSBuildProjectDirectory)/bin/**</DefaultItemExcludes>
  </PropertyGroup>

  <PropertyGroup>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The public API uses C# 13 params collections (params ReadOnlySpan<T>). -->
    <LangVersion>14</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Repo implementation, tests, samples, and benchmarks deliberately opt in to these
         experimental features. This props file is not distributed to package consumers. -->
    <NoWarn>$(NoWarn);RSP0001;RSP0002;RSP0003;RSP0004;RSP0005;RSP0006</NoWarn>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(TF_BUILD)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      Library projects that ship as NuGet packages, one per line. Add a new library package here.
      Whitespace is stripped and the list gets a leading ';', so membership is an exact ';Name;' match.
      _RespireValidatePackageProjectList (below) fails the build when a listed name has no project under
      src/, or when a src/ project is neither listed nor in RespireNonPackageProjects.
    -->
    <RespirePackageProjects>
      Aspire.Respire;
      Aspire.Respire.DistributedCaching;
      Aspire.Respire.HybridCaching;
      Aspire.Respire.OutputCaching;
      Respire;
      Respire.AI;
      Respire.Compression.Lz4;
      Respire.Compression.Zstd;
      Respire.Aws;
      Respire.Azure;
      Respire.Gcp;
      Respire.Caching;
      Respire.Caching.Hybrid;
      Respire.FusionCache;
      Respire.Coordination;
      Respire.DataProtection;
      Respire.DependencyInjection;
      Respire.HealthChecks;
      Respire.Idempotency;
      Respire.Json;
      Respire.OutputCaching;
      Respire.Probabilistic;
      Respire.RateLimiting;
      Respire.Resilience;
      Respire.Search;
      Respire.SignalR;
      Respire.Serialization.MessagePack;
      Respire.Serialization.MemoryPack;
      Respire.Serialization.Protobuf;
      Respire.Streaming;
      Respire.Streaming.Dashboard;
      Respire.StackExchangeCompat;
      Respire.TimeSeries;
      Respire.VectorData;
      Respire.Testing;
      Respire.Testing.Containers;
      Respire.Testing.StackExchangeCompat;
    </RespirePackageProjects>
    <_RespirePackageProjectList>;$([System.Text.RegularExpressions.Regex]::Replace('$(RespirePackageProjects)', '\s', ''))</_RespirePackageProjectList>
    <!-- Content-only packages have no shipping assembly or public API baseline. -->
    <RespireContentPackageProjects>;Respire.Templates;</RespireContentPackageProjects>
    <IsRespirePackageProject>false</IsRespirePackageProject>
    <IsRespirePackageProject Condition="$(_RespirePackageProjectList.Contains(';$(MSBuildProjectName);'))">true</IsRespirePackageProject>
    <IsRespireContentPackageProject>false</IsRespireContentPackageProject>
    <IsRespireContentPackageProject Condition="$(RespireContentPackageProjects.Contains(';$(MSBuildProjectName);'))">true</IsRespireContentPackageProject>
    <IsPackable>$(IsRespirePackageProject)</IsPackable>
    <IsPackable Condition="'$(IsRespireContentPackageProject)' == 'true'">true</IsPackable>
    <!-- src/ projects that deliberately do not ship as their own package. -->
    <RespireNonPackageProjects>;Respire.Analyzers;</RespireNonPackageProjects>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <!-- Set PackageValidationBaselineVersion to 2.0.0 only after that major is on NuGet.
         Until then, validate compatible assets within each package. See website/docs/contributing.md. -->
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsRespirePackageProject)' == 'true' Or '$(MSBuildProjectName)' == 'Respire.Analyzers'">
    <!-- Includes the netstandard analyzer assembly, where SDK analyzers are not enabled by default. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevelPerformance>latest-all</AnalysisLevelPerformance>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Runs once, in the core project, so a typo in the package list cannot silently make a project unpackable. -->
  <Target Name="_RespireValidatePackageProjectList" BeforeTargets="Build" Condition="'$(MSBuildProjectName)' == 'Respire'">
    <ItemGroup>
      <_RespireListedPackageProject Include="$([MSBuild]::Unescape($(_RespirePackageProjectList)))" />
      <_RespireListedPackageProject Include="$(RespireContentPackageProjects)" />
      <_RespireSourceProject Include="$(MSBuildThisFileDirectory)src/*/*.csproj" />
    </ItemGroup>
    <Error Condition="!Exists('$(MSBuildThisFileDirectory)src/%(_RespireListedPackageProject.Identity)/%(_RespireListedPackageProject.Identity).csproj')"
           Text="The package inventory lists '%(_RespireListedPackageProject.Identity)', but src/%(_RespireListedPackageProject.Identity)/%(_RespireListedPackageProject.Identity).csproj does not exist." />
    <Error Condition="!$(_RespirePackageProjectList.Contains(';%(_RespireSourceProject.Filename);')) And !$(RespireContentPackageProjects.Contains(';%(_RespireSourceProject.Filename);')) And !$(RespireNonPackageProjects.Contains(';%(_RespireSourceProject.Filename);'))"
           Text="src project '%(_RespireSourceProject.Filename)' is not in RespirePackageProjects, RespireContentPackageProjects or RespireNonPackageProjects in Directory.Build.props." />
  </Target>

  <Target Name="_RespireValidateLibraryNaming" BeforeTargets="PrepareForBuild"
          Condition="'$(IsRespirePackageProject)' == 'true' Or '$(MSBuildProjectName)' == 'Respire.Analyzers'">
    <Error Condition="'$(AssemblyName)' != '$(MSBuildProjectName)' Or '$(RootNamespace)' != '$(MSBuildProjectName)'"
           Text="Library project $(MSBuildProjectName) must use its project name for AssemblyName and RootNamespace." />
    <Error Condition="'$(IsRespirePackageProject)' == 'true' And '$(PackageId)' != '$(MSBuildProjectName)'"
           Text="Library project $(MSBuildProjectName) must use its project name for PackageId." />
  </Target>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Respire.DataProtection.Tests' Or '$(MSBuildProjectName)' == 'Respire.Coordination.Tests' Or '$(MSBuildProjectName)' == 'Respire.Azure.Tests' Or '$(MSBuildProjectName)' == 'Respire.Tests' Or '$(MSBuildProjectName)' == 'Respire.IntegrationTests' Or '$(MSBuildProjectName)' == 'Respire.Caching.Tests' Or '$(MSBuildProjectName)' == 'Respire.Caching.Hybrid.Tests' Or '$(MSBuildProjectName)' == 'Respire.HealthChecks.Tests' Or '$(MSBuildProjectName)' == 'Respire.Pipeline.Tests'">
    <IsTestProject>true</IsTestProject>
    <!-- Bridge Microsoft.Testing.Platform (TUnit) into `dotnet test` for the pipeline. -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Respire.StackExchangeCompat.Tests'">
    <IsTestProject>true</IsTestProject>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsRespirePackageProject)' == 'true' Or '$(IsRespireContentPackageProject)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <Authors>Tom Hurst</Authors>
    <Company>Respire</Company>
    <Product>Respire</Product>
    <Copyright>Copyright (c) 2026 Tom Hurst</Copyright>
    <PackageProjectUrl>https://respire.tomlonghurst.dev/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/thomhurst/Respire</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>redis;valkey;keydb;resp;cache;caching;client;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLanguage>en-US</PackageLanguage>
    <NeutralLanguage>en-US</NeutralLanguage>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <Target Name="_RespireValidatePublicApiFiles" BeforeTargets="CoreCompile"
          Condition="'$(IsRespirePackageProject)' == 'true' And '$(TargetFramework)' != ''">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt') Or !Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')"
           Text="$(MSBuildProjectName) requires shipped and unshipped API baselines. See website/docs/packages.md." />
  </Target>

  <ItemGroup Condition="'$(IsRespirePackageProject)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <!-- The package's buildTransitive targets include the two PublicAPI files as AdditionalFiles. -->
  </ItemGroup>
  <ItemGroup Condition="'$(IsRespirePackageProject)' == 'true' Or '$(IsRespireContentPackageProject)' == 'true'">
    <Content Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="/" />
    <None Include="$(RepositoryRoot)assets/nuget/icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
